import React, { useState, useEffect } from 'react';
import { db } from '../firebase';
import { collection, addDoc, doc, getDoc, serverTimestamp, Timestamp, query, onSnapshot, where } from 'firebase/firestore';
import { Calendar, Plus, AlertCircle, CheckSquare, Copy, Trash2, Users } from 'lucide-react';
import clsx from 'clsx';

export default function Scheduler() {
    const [brands, setBrands] = useState([]);
    const [programs, setPrograms] = useState([]);
    const [users, setUsers] = useState([]);
    const [loading, setLoading] = useState(true);
    const [submitting, setSubmitting] = useState(false);
    const [success, setSuccess] = useState('');
    const [error, setError] = useState('');
    const [bulkMode, setBulkMode] = useState(false);
    const [bulkMethod, setBulkMethod] = useState('range'); // 'range' or 'manual'
    const [selectedDates, setSelectedDates] = useState([]);
    const [tempDate, setTempDate] = useState(''); // Temporary date before adding

    const [formData, setFormData] = useState({
        brand: '',
        program: '',
        description: '',
        dueDate: '',
        endDate: '', // For multi-day scheduling
        adCount: 1,
        taskCount: 1, // Number of copies
        assignTo: '',
        platforms: {
            facebook: false,
            youtube: false,
            tiktok: false
        },
        recurring: false,
        frequency: 'daily' // daily, weekly, monthly
    });

    useEffect(() => {
        const fetchMetadata = async () => {
            try {
                const docRef = doc(db, 'metadata', 'lists');
                const docSnap = await getDoc(docRef);

                if (docSnap.exists()) {
                    const data = docSnap.data();
                    setBrands(data.brands || []);
                    setPrograms(data.programs || []);
                }
            } catch (err) {
                console.error("Error fetching metadata:", err);
                setError("Failed to load form data. Please try again.");
            } finally {
                setLoading(false);
            }
        };

        fetchMetadata();
    }, []);

    // Fetch users with editor role
    useEffect(() => {
        const q = query(collection(db, 'users'), where('role', '==', 'editor'));
        const unsubscribe = onSnapshot(q, (snapshot) => {
            const usersData = snapshot.docs.map(doc => ({
                id: doc.id,
                ...doc.data()
            }));
            setUsers(usersData);
        });

        return unsubscribe;
    }, []);

    const handlePlatformChange = (platform) => {
        setFormData(prev => ({
            ...prev,
            platforms: {
                ...prev.platforms,
                [platform]: !prev.platforms[platform]
            }
        }));
    };

    const generateDateRange = (startDate, endDate, frequency) => {
        const dates = [];
        const start = new Date(startDate);
        const end = new Date(endDate);

        let current = new Date(start);

        while (current <= end) {
            dates.push(new Date(current));

            if (frequency === 'daily') {
                current.setDate(current.getDate() + 1);
            } else if (frequency === 'weekly') {
                current.setDate(current.getDate() + 7);
            } else if (frequency === 'monthly') {
                current.setMonth(current.getMonth() + 1);
            }
        }

        return dates;
    };

    const handleSubmit = async (e) => {
        e.preventDefault();
        setSubmitting(true);
        setError('');
        setSuccess('');

        const selectedPlatforms = Object.keys(formData.platforms).filter(k => formData.platforms[k]);

        if (selectedPlatforms.length === 0) {
            setError("Please select at least one platform.");
            setSubmitting(false);
            return;
        }

        // Validate bulk manual mode has dates
        if (bulkMode && bulkMethod === 'manual' && selectedDates.length === 0) {
            setError("Please select at least one date.");
            setSubmitting(false);
            return;
        }

        try {
            let tasksCreated = 0;

            // Generate tasks based on mode
            let dates;
            if (bulkMode && bulkMethod === 'manual') {
                dates = selectedDates;
            } else if (bulkMode && bulkMethod === 'range' && formData.endDate) {
                dates = generateDateRange(formData.dueDate, formData.endDate, formData.frequency);
            } else {
                dates = [new Date(formData.dueDate)];
            }

            for (const date of dates) {
                // Create multiple copies if taskCount > 1
                const copies = Math.max(1, parseInt(formData.taskCount) || 1);

                for (let i = 0; i < copies; i++) {
                    const taskData = {
                        created_at: serverTimestamp(),
                        status: formData.assignTo ? 'Assigned' : 'Pending',
                        brand: formData.brand,
                        program: formData.program,
                        description: formData.description,
                        platform: selectedPlatforms,
                        due_date: Timestamp.fromDate(date),
                        ad_count: parseInt(formData.adCount)
                    };

                    if (formData.assignTo) {
                        taskData.editor_id = formData.assignTo;
                    }

                    await addDoc(collection(db, 'tasks'), taskData);
                    tasksCreated++;
                }
            }

            setSuccess(`${tasksCreated} task(s) created successfully!`);
            setFormData({
                brand: '',
                program: '',
                description: '',
                dueDate: '',
                endDate: '',
                adCount: 1,
                taskCount: 1,
                assignTo: '',
                platforms: { facebook: false, youtube: false, tiktok: false },
                recurring: false,
                frequency: 'daily'
            });
        } catch (err) {
            setError("Failed to create task: " + err.message);
        } finally {
            setSubmitting(false);
        }
    };

    const duplicateLastTask = () => {
        // Keep current values but clear dates
        setFormData(prev => ({
            ...prev,
            dueDate: '',
            endDate: ''
        }));
        setSuccess('Form duplicated! Set new dates and submit.');
    };

    if (loading) return <div className="p-8 text-center text-slate-500">Loading form data...</div>;

    return (
        <div className="max-w-4xl mx-auto animate-fadeIn pb-8">
            <div className="mb-8 flex justify-between items-center">
                <div>
                    <h1 className="text-3xl font-bold text-gradient">Schedule Tasks</h1>
                    <p className="text-slate-600 font-medium mt-1">Create single or multiple brand sheets for production</p>
                </div>

                <div className="flex gap-3">
                    <button
                        onClick={duplicateLastTask}
                        className="flex items-center gap-2 px-5 py-2.5 bg-white/80 backdrop-blur-sm text-slate-700 font-bold rounded-xl hover:bg-white hover:shadow-md transition-all border border-slate-200"
                    >
                        <Copy size={18} />
                        Duplicate
                    </button>
                    <button
                        onClick={() => setBulkMode(!bulkMode)}
                        className={clsx(
                            "flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold transition-all shadow-sm hover:shadow-md",
                            bulkMode
                                ? "gradient-primary text-white border-transparent"
                                : "bg-white/80 backdrop-blur-sm text-slate-700 border border-slate-200 hover:bg-white"
                        )}
                    >
                        <Calendar size={18} />
                        {bulkMode ? 'Single Task' : 'Bulk Schedule'}
                    </button>
                </div>
            </div>

            <div className="card-glass rounded-2xl shadow-premium p-8 animate-slideUp">
                {error && (
                    <div className="mb-6 p-4 bg-red-50/80 backdrop-blur-sm border border-red-100 text-red-700 rounded-xl flex items-center gap-3 shadow-sm">
                        <AlertCircle size={20} />
                        <span className="font-medium">{error}</span>
                    </div>
                )}

                {success && (
                    <div className="mb-6 p-4 bg-green-50/80 backdrop-blur-sm border border-green-100 text-green-700 rounded-xl flex items-center gap-3 shadow-sm">
                        <CheckSquare size={20} />
                        <span className="font-medium">{success}</span>
                    </div>
                )}

                <form onSubmit={handleSubmit} className="space-y-8">
                    <div className="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div>
                            <label className="block text-sm font-bold text-slate-700 mb-2">Brand *</label>
                            <select
                                required
                                className="w-full px-4 py-3 bg-white/50 backdrop-blur-sm border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all font-medium"
                                value={formData.brand}
                                onChange={(e) => setFormData({ ...formData, brand: e.target.value })}
                            >
                                <option value="">Select Brand</option>
                                {brands.map(b => <option key={b} value={b}>{b}</option>)}
                            </select>
                        </div>

                        <div>
                            <label className="block text-sm font-bold text-slate-700 mb-2">Program *</label>
                            <select
                                required
                                className="w-full px-4 py-3 bg-white/50 backdrop-blur-sm border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all font-medium"
                                value={formData.program}
                                onChange={(e) => setFormData({ ...formData, program: e.target.value })}
                            >
                                <option value="">Select Program</option>
                                {programs.map(p => <option key={p} value={p}>{p}</option>)}
                            </select>
                        </div>
                    </div>

                    <div>
                        <label className="block text-sm font-bold text-slate-700 mb-2">Description *</label>
                        <textarea
                            required
                            rows={3}
                            className="w-full px-4 py-3 bg-white/50 backdrop-blur-sm border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all font-medium resize-none"
                            value={formData.description}
                            onChange={(e) => setFormData({ ...formData, description: e.target.value })}
                            placeholder="Task details..."
                        />
                    </div>

                    {bulkMode ? (
                        <div className="bg-indigo-50/50 backdrop-blur-sm p-6 rounded-2xl border border-indigo-100 shadow-inner">
                            <div className="flex items-center justify-between mb-4">
                                <h3 className="text-sm font-bold text-indigo-900 uppercase tracking-wide">Bulk Scheduling</h3>
                                <div className="flex gap-2">
                                    <button
                                        type="button"
                                        onClick={() => setBulkMethod('range')}
                                        className={clsx(
                                            "px-4 py-2 rounded-lg font-medium text-sm transition-all",
                                            bulkMethod === 'range'
                                                ? "bg-indigo-600 text-white shadow-md"
                                                : "bg-white text-slate-700 hover:bg-slate-50"
                                        )}
                                    >
                                        Date Range
                                    </button>
                                    <button
                                        type="button"
                                        onClick={() => {
                                            setBulkMethod('manual');
                                            setSelectedDates([]);
                                        }}
                                        className={clsx(
                                            "px-4 py-2 rounded-lg font-medium text-sm transition-all",
                                            bulkMethod === 'manual'
                                                ? "bg-indigo-600 text-white shadow-md"
                                                : "bg-white text-slate-700 hover:bg-slate-50"
                                        )}
                                    >
                                        Manual Selection
                                    </button>
                                </div>
                            </div>

                            {bulkMethod === 'range' ? (
                                <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
                                    <div>
                                        <label className="block text-sm font-bold text-slate-700 mb-2">Start Date *</label>
                                        <input
                                            type="date"
                                            required
                                            className="w-full px-4 py-2.5 bg-white border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all font-medium"
                                            value={formData.dueDate}
                                            onChange={(e) => setFormData({ ...formData, dueDate: e.target.value })}
                                        />
                                    </div>

                                    <div>
                                        <label className="block text-sm font-bold text-slate-700 mb-2">End Date *</label>
                                        <input
                                            type="date"
                                            required
                                            className="w-full px-4 py-2.5 bg-white border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all font-medium"
                                            value={formData.endDate}
                                            onChange={(e) => setFormData({ ...formData, endDate: e.target.value })}
                                        />
                                    </div>

                                    <div>
                                        <label className="block text-sm font-bold text-slate-700 mb-2">Frequency</label>
                                        <select
                                            className="w-full px-4 py-2.5 bg-white border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all font-medium"
                                            value={formData.frequency}
                                            onChange={(e) => setFormData({ ...formData, frequency: e.target.value })}
                                        >
                                            <option value="daily">Daily</option>
                                            <option value="weekly">Weekly</option>
                                            <option value="monthly">Monthly</option>
                                        </select>
                                    </div>
                                </div>
                                                    Selected Dates ({selectedDates.length})
                                                </label>
                                                <button
                                                    type="button"
                                                    onClick={() => setSelectedDates([])}
                                                    className="text-xs text-red-600 hover:text-red-700 font-medium"
                                                >
                                                    Clear All
                                                </button>
                                            </div>
            <div className="flex flex-wrap gap-2">
                {selectedDates.map((date, index) => (
                    <div
                        key={index}
                        className="flex items-center gap-2 px-3 py-1.5 bg-indigo-100 text-indigo-700 rounded-lg font-medium text-sm"
                    >
                        <Calendar size={14} />
                        {date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                        <button
                            type="button"
                            onClick={() => {
                                setSelectedDates(selectedDates.filter((_, i) => i !== index));
                            }}
                            className="ml-1 text-indigo-600 hover:text-indigo-800"
                        >
                            <Trash2 size={14} />
                        </button>
                    </div>
                ))}
            </div>
        </div>
    )
}
                                </div >
                            )}
                        </div >
                    ) : (
    <div className="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>
            <label className="block text-sm font-bold text-slate-700 mb-2">Due Date *</label>
            <input
                type="date"
                required
                className="w-full px-4 py-3 bg-white/50 backdrop-blur-sm border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all font-medium"
                value={formData.dueDate}
                onChange={(e) => setFormData({ ...formData, dueDate: e.target.value })}
            />
        </div>

        <div>
            <label className="block text-sm font-bold text-slate-700 mb-2">Ad Count</label>
            <input
                type="number"
                min="1"
                required
                className="w-full px-4 py-3 bg-white/50 backdrop-blur-sm border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all font-medium"
                value={formData.adCount}
                onChange={(e) => setFormData({ ...formData, adCount: e.target.value })}
            />
        </div>

        <div>
            <label className="block text-sm font-bold text-slate-700 mb-2">Task Count (Copies)</label>
            <input
                type="number"
                min="1"
                max="50"
                required
                className="w-full px-4 py-3 bg-white/50 backdrop-blur-sm border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all font-medium"
                value={formData.taskCount}
                onChange={(e) => setFormData({ ...formData, taskCount: e.target.value })}
            />
        </div>
    </div>
)}

                    <div className="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div>
                            <label className="block text-sm font-bold text-slate-700 mb-2">Assign To (Optional)</label>
                            <select
                                className="w-full px-4 py-3 bg-white/50 backdrop-blur-sm border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all font-medium"
                                value={formData.assignTo}
                                onChange={(e) => setFormData({ ...formData, assignTo: e.target.value })}
                            >
                                <option value="">Unassigned</option>
                                {users.map(user => (
                                    <option key={user.id} value={user.id}>
                                        {user.name || user.email}
                                    </option>
                                ))}
                            </select>
                        </div>

                        <div>
                            <label className="block text-sm font-bold text-slate-700 mb-2">Platforms *</label>
                            <div className="flex gap-4 pt-2">
                                {['Facebook', 'YouTube', 'TikTok'].map(platform => (
                                    <label key={platform} className="flex items-center gap-2 cursor-pointer group">
                                        <div className="relative flex items-center">
                                            <input
                                                type="checkbox"
                                                className="peer sr-only"
                                                checked={formData.platforms[platform.toLowerCase()]}
                                                onChange={() => handlePlatformChange(platform.toLowerCase())}
                                            />
                                            <div className="w-5 h-5 border-2 border-slate-300 rounded-md peer-checked:bg-indigo-600 peer-checked:border-indigo-600 transition-all flex items-center justify-center">
                                                <div className="w-2.5 h-1.5 border-b-2 border-l-2 border-white -rotate-45 mt-[-2px] opacity-0 peer-checked:opacity-100"></div>
                                            </div>
                                        </div>
                                        <span className="text-slate-700 font-medium group-hover:text-indigo-600 transition-colors">{platform}</span>
                                    </label>
                                ))}
                            </div>
                        </div>
                    </div>

                    <button
                        type="submit"
                        disabled={submitting}
                        className="w-full gradient-primary text-white py-4 rounded-xl font-bold text-lg shadow-lg hover:shadow-glow hover:scale-[1.01] active:scale-[0.99] transition-all flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
                    >
                        <Plus size={22} />
                        {submitting ? 'Creating...' : bulkMode ? 'Create Multiple Tasks' : `Create ${formData.taskCount > 1 ? formData.taskCount + ' Tasks' : 'Task'}`}
                    </button>
                </form >
            </div >
        </div >
    );
}
